<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="styles.css">
    <link href="https://s4.zstatic.net/ajax/libs/prism/1.30.0/themes/prism.min.css" rel="stylesheet">
    <link href="https://s4.zstatic.net/ajax/libs/KaTeX/0.16.9/katex.min.css" rel="stylesheet">
</head>
<body>
    <!-- 顶部菜单栏 -->
    <header class="top-navbar">
        <div class="navbar-left">
            <button class="sidebar-toggle" id="sidebarToggle" aria-label="切换侧边栏">
                <span class="toggle-icon">☰</span>
            </button>
            <div class="navbar-title"><%= bookTitle %></div>
        </div>
        <div class="navbar-right">
            <div class="search-container">
                <span class="search-icon">🔍</span>
                <input type="text" id="searchInput" class="search-input" placeholder="搜索..." aria-label="搜索">
                <div class="search-results" id="searchResults"></div>
            </div>
            <button class="ai-entry-button" id="aiEntryButton" type="button" aria-label="打开 AI 问答">
                AI
            </button>
            <nav class="navbar-nav">
                <a href="index.html" class="nav-link active">首页</a>
                <% (navLinks || []).forEach(function (link) { %>
                    <% const isExternal = /^(https?:)?\/\//i.test(link.url); %>
                    <a href="<%= link.url %>" class="nav-link"<% if (isExternal) { %> target="_blank" rel="noopener noreferrer"<% } %>><%= link.text %></a>
                <% }); %>
            </nav>
        </div>
    </header>
    
    <div class="container">
        <aside class="sidebar" id="sidebar">
            <!-- <div class="sidebar-header"> -->
                <!-- <h1><%= bookTitle %></h1> -->
            <!-- </div> -->
            <nav class="sidebar-nav">
                <%- sidebar %>
            </nav>
        </aside>
        
        <main class="main-content">
            <div class="content-wrapper">
                <article class="content-body">
                    <%- htmlContent %>
                </article>
                
                <% if (toc) { %>
                    <aside class="toc" id="toc">
                        <div class="toc-header">
                            <h3>目录</h3>
                            <button class="toc-toggle" id="tocToggle" aria-label="切换目录">
                                <span class="toc-toggle-icon">×</span>
                            </button>
                        </div>
                        <div class="toc-content">
                            <%- toc %>
                        </div>
                    </aside>
                <% } %>
            </div>
        </main>
    </div>
    
    <!-- 回到顶部按钮 -->
    <button class="back-to-top" id="backToTop" aria-label="回到顶部">
        <span class="back-to-top-icon">↑</span>
    </button>

    <div class="ai-chat-overlay" id="aiChatOverlay" hidden></div>
    <section
        class="ai-chat-panel"
        id="aiChatPanel"
        aria-hidden="true"
        aria-labelledby="aiChatTitle"
    >
        <div class="ai-chat-header">
            <div>
                <h2 class="ai-chat-title" id="aiChatTitle">AI 文档问答</h2>
                <p class="ai-chat-subtitle">优先基于当前页面，必要时补充全站相关片段</p>
            </div>
            <button class="ai-chat-close" id="aiChatClose" type="button" aria-label="关闭 AI 问答">
                ×
            </button>
        </div>

        <div class="ai-chat-config">
            <div class="ai-chat-config-header">
                <h3>连接配置</h3>
                <span class="ai-chat-config-tip">保存在浏览器本地 localStorage</span>
            </div>
            <div class="ai-chat-config-grid">
                <label class="ai-chat-field">
                    <span>Base URL</span>
                    <input
                        id="aiBaseUrlInput"
                        class="ai-chat-input"
                        type="url"
                        placeholder="https://api.openai.com/v1"
                        autocomplete="off"
                    >
                </label>
                <label class="ai-chat-field">
                    <span>Model</span>
                    <input
                        id="aiModelInput"
                        class="ai-chat-input"
                        type="text"
                        placeholder="gpt-4o-mini"
                        autocomplete="off"
                    >
                </label>
                <label class="ai-chat-field ai-chat-field-full">
                    <span>API Key</span>
                    <input
                        id="aiApiKeyInput"
                        class="ai-chat-input"
                        type="password"
                        placeholder="sk-..."
                        autocomplete="off"
                    >
                </label>
            </div>
            <div class="ai-chat-config-actions">
                <button class="ai-chat-secondary-button" id="aiSaveConfigButton" type="button">保存配置</button>
                <div class="ai-chat-status" id="aiChatStatus" aria-live="polite"></div>
            </div>
        </div>

        <div class="ai-chat-messages" id="aiChatMessages" aria-live="polite">
            <div class="ai-chat-message ai-chat-message-assistant">
                <div class="ai-chat-message-role">AI</div>
                <div class="ai-chat-message-content">
                    你好，可以直接提问。我会优先根据当前页面内容回答，必要时再参考全站相关片段。
                </div>
            </div>
        </div>

        <form class="ai-chat-composer" id="aiChatForm">
            <label class="ai-chat-field ai-chat-field-full" for="aiQuestionInput">
                <span>问题</span>
                <textarea
                    id="aiQuestionInput"
                    class="ai-chat-textarea"
                    placeholder="例如：总结这一页的核心内容"
                    rows="4"
                ></textarea>
            </label>
            <div class="ai-chat-composer-actions">
                <div class="ai-chat-context-tip">上下文来源：当前页优先，全站片段补充</div>
                <button class="ai-chat-primary-button" id="aiSendButton" type="submit">发送</button>
            </div>
        </form>
    </section>
    
    <script type="module" src="script.js"></script>
    <script src="https://s4.zstatic.net/ajax/libs/prism/1.30.0/components/prism-core.min.js"></script>
    <script src="https://s4.zstatic.net/ajax/libs/prism/1.30.0/plugins/autoloader/prism-autoloader.min.js"></script>
    <script defer src="https://s4.zstatic.net/ajax/libs/mermaid/11.12.0/mermaid.min.js" onload="mermaid.initialize({ startOnLoad: true });"></script>
</body>
</html>